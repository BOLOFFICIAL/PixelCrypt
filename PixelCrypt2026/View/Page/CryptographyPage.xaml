<Page x:Class="PixelCrypt2026.View.Page.CryptographyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PixelCrypt2026.View.Page" 
      xmlns:controls="clr-namespace:PixelCrypt2026.View.UserControl" 
      xmlns:mini="clr-namespace:PixelCrypt2026.View.UserControl.Mini"
      mc:Ignorable="d"
      Title="CryptographyPage"
      TextElement.FontFamily="{StaticResource Font}">

    <controls:BasePageLayout Title="{Binding Title}"
                             BackCommand="{Binding BackCommand}">
        <controls:BasePageLayout.PageContent>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="325"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="{Binding SettingsHeight}"/>
                        <RowDefinition Height="{Binding TaskControlHeight}"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <controls:ProgressPanel DataContext="{Binding Progress}"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <controls:ImageList DataContext="{Binding ImageList}"/>
                    </Grid>

                    <Grid Grid.Row="2"
                          Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Border Background="{StaticResource Background1}"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Label Content="Interference level"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               FontSize="15"
                                               Foreground="{StaticResource Foreground}"/>
                                    </Grid>

                                    <Grid Grid.Column="1"
                                          Margin="0,5,5,5">
                                        <Border CornerRadius="10"
                                                BorderBrush="{StaticResource BorderSubtle}"
                                                BorderThickness="1">
                                            <ComboBox ItemsSource="{Binding ComboBoxItem}"
                                                      SelectedValue="{Binding Interference}">
                                                <ComboBox.ToolTip>
                                                    <ToolTip BorderThickness="0" 
                                                             Background="Transparent" 
                                                             Placement="Mouse">
                                                        <mini:InfoToolTip 
                                                            Title="Interference level"
                                                            Info="• Sets the block size for the permutation algorithm as a percentage of the maximum possible blocks.&#x0a;• Higher values create smaller blocks and more complex rearrangement, making the image completely unrecognizable."/>
                                                    </ToolTip>
                                                </ComboBox.ToolTip>
                                            </ComboBox>
                                        </Border>

                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="0,10,0,0">
                            <controls:ModeControl DataContext="{Binding ModeControl}"/>
                        </Grid>

                        <Grid Grid.Row="2"
                              Margin="0,10,0,0">
                            <controls:PasswordBox DataContext="{Binding PasswordBox}"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="3"
                          Margin="0,10,0,0">
                        <controls:TaskControl DataContext="{Binding TaskControl}"/>
                    </Grid>
                </Grid>

                <Grid Grid.Column="1">
                    <Border Grid.Column="1"
                            Padding="5"
                            Margin="10,0,0,0"
                            Background="{StaticResource Background1}"
                            CornerRadius="10">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="{Binding WidthResultImage}"/>
                            </Grid.ColumnDefinitions>

                            <Grid Margin="5"
                                  Grid.Column="0">
                                <Border Background="{StaticResource Background2}"
                                        CornerRadius="10"
                                        Padding="10">
                                    <Border Background="{StaticResource Background3}"
                                            BorderBrush="{StaticResource BorderSubtle}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Padding="10">
                                        <Image Stretch="Uniform"
                                               Source="{Binding ImageList.SelectedImage.ImageFile.FilePath}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                    </Border>
                                </Border>
                            </Grid>

                            <Grid Margin="5"
                                  Grid.Column="1">
                                <Border Background="{StaticResource Background2}"
                                        CornerRadius="10"
                                        Padding="10">
                                    <Border Background="{StaticResource Background3}"
                                            BorderBrush="{StaticResource BorderSubtle}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Padding="10">
                                        <Image Stretch="Uniform"
                                               Source="{Binding ResultImageSource}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                    </Border>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </controls:BasePageLayout.PageContent>
    </controls:BasePageLayout>
</Page>
