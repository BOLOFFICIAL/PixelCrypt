<UserControl x:Class="PixelCrypt2026.View.UserControl.Mini.ImageToolTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mini="clr-namespace:PixelCrypt2026.View.UserControl.Mini"
             mc:Ignorable="d"
             x:Name="root">

    <Border Background="{StaticResource Background2}" 
            BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=mini:ImageToolTip}}" 
            BorderThickness="2" 
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.15" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="180"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Padding="15,10">
                <StackPanel>
                    <TextBlock Text="{Binding FileName, ElementName=root}" 
                               Foreground="{StaticResource Foreground}" 
                               FontWeight="SemiBold" 
                               FontSize="20" 
                               TextWrapping="Wrap" 
                               Margin="0,0,0,10"/>

                    <Border Height="3" 
                            Background="{StaticResource Accent}" 
                            Opacity="0.5" 
                            Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="FILE SIZE" 
                                       Foreground="{StaticResource Accent}" 
                                       FontSize="10" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding FileSizeFormatted, ElementName=root}" 
                                       Foreground="{StaticResource Foreground}" 
                                       FontWeight="Regular" 
                                       FontSize="15" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBlock Text="RESOLUTION" 
                                       Foreground="{StaticResource Accent}" 
                                       FontSize="10" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding ImageResolution, ElementName=root}" 
                                       Foreground="{StaticResource Foreground}" 
                                       FontWeight="Regular" 
                                       FontSize="15" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="LOCATION" 
                                       Foreground="{StaticResource Accent}" 
                                       FontSize="10" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding FilePath, ElementName=root}" 
                                       Foreground="{StaticResource Foreground}" 
                                       FontWeight="Regular" 
                                       TextWrapping="Wrap" 
                                       FontSize="15" 
                                       ToolTip="{Binding FilePath}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" 
                    Background="{StaticResource Background3}" 
                    CornerRadius="10" 
                    Padding="10" 
                    Margin="5" 
                    Width="220">
                <Image Stretch="Uniform" 
                       MaxWidth="200" 
                       MaxHeight="400" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       Source="{Binding FilePath, ElementName=root}"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
