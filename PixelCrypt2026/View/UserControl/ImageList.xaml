<UserControl x:Class="PixelCrypt2026.View.UserControl.ImageList" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PixelCrypt2026.View.UserControl" 
             xmlns:controls="clr-namespace:PixelCrypt2026.View.UserControl" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             FontFamily="{StaticResource Font}">
    <Border Background="{StaticResource Background1}"
            Padding="10,10,10,0"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="{Binding HeightButtons}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" 
                  Margin="0,0,0,10"
                  HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding WidthAdd}"/>
                    <ColumnDefinition Width="{Binding WidthClear}"/>
                </Grid.ColumnDefinitions>
                
                <Grid Grid.Column="0" 
                      Margin="0,0,10,0">
                    <Button Content="Add" 
                            Command="{Binding AddImageCommand}"/>
                </Grid>
                
                <Grid Grid.Column="1">
                    <Button Content="Clear" 
                            Command="{Binding ClearImagesCommand}"/>
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <Border Background="{StaticResource Background2}"
                        CornerRadius="10"
                        Padding="5,5,5,0"
                        AllowDrop="True"
                        Margin="0,0,0,10">

                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Background2}"/>
                            <Style.Triggers>

                                <EventTrigger RoutedEvent="Border.PreviewDragOver">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="BorderBrush"
                                                                           Duration="0:0:0">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0"
                                                                        Value="{StaticResource Accent}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <EventTrigger RoutedEvent="Border.PreviewDragLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="BorderBrush"
                                                                           Duration="0:0:0">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0"
                                                                        Value="{StaticResource Background2}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <EventTrigger RoutedEvent="Border.PreviewDrop">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="BorderBrush"
                                                                           Duration="0:0:0">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0"
                                                                        Value="{StaticResource Background2}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Drop">
                            <i:InvokeCommandAction Command="{Binding DropCommand}" 
                                   PassEventArgsToCommand="True"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>

                    <ListBox ItemsSource="{Binding Images}"
                             Background="Transparent"
                             BorderThickness="0"
                             VirtualizingPanel.IsVirtualizing="True"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectedItem="{Binding SelectedImage}"
                             Tag="{Binding}">

                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="ContextMenu" Value="{x:Null}" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag.IsEnable, RelativeSource={RelativeSource Self}}" 
                                                 Value="True">
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                               RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Paste" 
                                                              Command="{Binding PasteImagesCommand}" />
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">

                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch"/>

                                <Setter Property="Background" 
                                        Value="Transparent"/>
                                <Setter Property="BorderBrush" 
                                        Value="Transparent"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                                <Setter Property="Tag"
                                        Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag.IsEnable, RelativeSource={RelativeSource Self}}" 
                                                 Value="True">
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Move up"
                                                              Command="{Binding Tag.MoveUpCommand}"
                                                              CommandParameter="{Binding DataContext}"/>

                                                    <MenuItem Header="Move down"
                                                              Command="{Binding Tag.MoveDownCommand}"
                                                              CommandParameter="{Binding DataContext}"/>

                                                    <MenuItem Header="Delete"
                                                              Command="{Binding Tag.RemoveCommand}"
                                                              CommandParameter="{Binding DataContext}"/>

                                                    <MenuItem Header="Open"
                                                              Command="{Binding Tag.OpenOriginalCommand}"
                                                              CommandParameter="{Binding DataContext}"/>
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <controls:ImageChip Image="{Binding}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>