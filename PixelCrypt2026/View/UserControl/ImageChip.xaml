<UserControl x:Class="PixelCrypt2026.View.UserControl.ImageChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PixelCrypt2026.View.UserControl" 
             xmlns:mini="clr-namespace:PixelCrypt2026.View.UserControl.Mini">

    <Grid DataContext="{Binding Image, RelativeSource={RelativeSource AncestorType=local:ImageChip}}"
          Margin="0,0,0,10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding StatusWidth}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="0,0,5,0"
                Padding="10,5"
                VerticalAlignment="Top"
                Background="{Binding StatusBackground}"
                CornerRadius="10">

            <TextBlock Text="{Binding StatusValue}"
                       FontSize="15"
                       Foreground="{StaticResource Foreground}"/>
            
        </Border>

        <Border Grid.Column="1"
                Background="{Binding Background}"
                CornerRadius="10"
                BorderThickness="1">
            
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{Binding Foreground}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Text="{Binding ImageFile.FileName}"
                       Foreground="{Binding Foreground}"
                       VerticalAlignment="Center"
                       Padding="10,5"
                       FontSize="15"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap">

                <TextBlock.ToolTip>
                    <ToolTip BorderThickness="0" 
                             Background="Transparent" 
                             MaxWidth="600" 
                             Placement="Mouse">
                        <mini:ImageToolTip 
                            FileName="{Binding ImageFile.FileName}"
                            FileSizeFormatted="{Binding ImageFile.FileSizeFormatted}"
                            ImageResolution="{Binding ImageFile.ImageResolution}"
                            FilePath="{Binding ImageFile.FilePath}"
                            Foreground="{Binding Foreground}"/>
                    </ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>

        </Border>
        
    </Grid>
    
</UserControl>