<Window x:Class="PixelCrypt2026.View.Window.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.com/icons/"
        mc:Ignorable="d"
        MinWidth="300"
        MaxWidth="420"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="NoResize">

    <Grid>

        <Border Background="{StaticResource Background1}"
                BorderBrush="{Binding StatusColor}"
                BorderThickness="1,5,1,1"
                CornerRadius="10"
                Padding="10,10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <fa:ImageAwesome Grid.Column="0"
                                     Icon="{Binding Icon}"
                                     Width="40"
                                     Height="40"
                                     Foreground="{Binding StatusColor}"
                                     VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Foreground}"
                               VerticalAlignment="Center"
                               Margin="10,0,10,0"
                               TextWrapping="Wrap"/>

                    <Button Grid.Column="2"
                            Background="Transparent"
                            Padding="0"
                            Command="{Binding CloseCommand}"
                            VerticalAlignment="Top">
                        <fa:ImageAwesome Icon="Regular_TimesCircle"
                                         Width="16"
                                         Height="16"
                                         Foreground="{StaticResource SecondaryForeground}"/>
                    </Button>
                </Grid>

                <Separator Grid.Row="1"
                           Margin="0,10"/>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Hidden"
                              MaxHeight="340">
                    <TextBlock Text="{Binding Content}"
                               FontSize="15"
                               Foreground="{StaticResource Foreground}"
                               TextWrapping="Wrap"
                               TextAlignment="Left"/>
                </ScrollViewer>

                <Grid Grid.Row="3"
                      Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding HeightButtonOk}"/>
                        <RowDefinition Height="{Binding HeightButtonYesNo}"/>
                        <RowDefinition Height="{Binding HeightButtonText}"/>
                        <RowDefinition Height="{Binding HeightButtonCustom}"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          HorizontalAlignment="Right">
                        <Button Content="Ok"
                                MinWidth="80"
                                Padding="15,5"
                                Command="{Binding OkCommand}"/>
                    </Grid>

                    <Grid Grid.Row="1"
                          HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="No"
                                    MinWidth="80"
                                    Padding="15,5"
                                    Margin="0,0,10,0"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource BorderStrong}"
                                    BorderThickness="1"
                                    Foreground="{StaticResource Foreground}"
                                    Command="{Binding NoCommand}"/>
                            <Button Content="Yes"
                                    MinWidth="80"
                                    Padding="15,5"
                                    Command="{Binding YesCommand}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Border Background="{StaticResource Background2}"
                                CornerRadius="10"
                                Padding="5">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             FontSize="15"
                                             MinHeight="40"
                                             MaxHeight="140"
                                             VerticalScrollBarVisibility="Hidden"
                                             Padding="5"
                                             Foreground="{StaticResource Foreground}"
                                             CaretBrush="{StaticResource Accent}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Background="Transparent"
                                             VerticalContentAlignment="Center"/>
                                </Grid>

                                <Button Grid.Column="1"
                                        Command="{Binding TextCommand}"
                                        Width="35"
                                        Height="35"
                                        Margin="0,5,5,5"
                                        VerticalAlignment="Bottom">
                                    <fa:ImageAwesome Icon="Solid_Play"
                                                     Foreground="{StaticResource ButtonForeground}"
                                                     Height="15"
                                                     Width="15"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3">
                        <ItemsControl ItemsSource="{Binding Buttons}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Text}"
                                            Command="{Binding Command}"
                                            Margin="0,5"
                                            Background="{StaticResource Background2}"
                                            Foreground="{StaticResource Foreground}"
                                            HorizontalAlignment="Stretch"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
