<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <OutputType>WinExe</OutputType>
	  <TargetFramework>net8.0-windows</TargetFramework>
	  <Nullable>enable</Nullable>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <UseWPF>true</UseWPF>
	  <ApplicationIcon>PixelCryptLogo.ico</ApplicationIcon>
	  <Version>3.0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="PixelCryptLogo.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FontAwesome5" Version="2.1.11" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.5" />
    <PackageReference Include="WindowsAPICodePack" Version="8.0.15.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BackgroundUpdater">
      <HintPath>..\BackgroundUpdater.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
